---
layout: default
---
{% assign is_zh = false %}{% if page.lang == 'zh-CN' %}{% assign is_zh = true %}{% endif %}
<article class="reading-page" lang="{{ page.lang | default: 'zh-CN' }}" data-blog-url="{{ page.url | relative_url }}">
  <header class="reading-header">
    <a class="reading-back" href="{{ '/blog/' | relative_url }}">{% if is_zh %}← 所有文章{% else %}← All articles{% endif %}</a>
    <p class="reading-meta"><time datetime="{{ page.date | date_to_xmlschema }}">{{ page.date | date: '%Y-%m-%d' }}</time>{% if page.preview %} · {% if is_zh %}样式预览{% else %}Style preview{% endif %}{% endif %}</p>
    <h1>{{ page.title | escape }}</h1>
    <p class="reading-description">{{ page.description | escape }}</p>
    <nav class="reading-languages" aria-label="{% if is_zh %}文章语言{% else %}Article language{% endif %}">
      {% assign translations = site.posts | where: 'translation_key', page.translation_key | sort: 'lang' %}
      {% for version in translations %}
      <a href="{{ version.url | relative_url }}" lang="{{ version.lang }}" hreflang="{{ version.lang }}"{% if version.url == page.url %} aria-current="page"{% endif %}>{% if version.lang == 'zh-CN' %}中文{% else %}English{% endif %}</a>
      {% endfor %}
    </nav>
  </header>
  <div class="reading-grid">
    <aside class="reading-toc" hidden>
      <details class="reading-toc-details">
        <summary>{% if is_zh %}本文目录{% else %}On this page{% endif %}</summary>
        <nav aria-label="{% if is_zh %}本文目录{% else %}Table of contents{% endif %}"><ol class="reading-toc-list"></ol></nav>
      </details>
    </aside>
    <div class="reading-content">{{ content }}</div>
  </div>
  {% if page.navigation_graph %}
  <details class="article-graph" data-graph-source="{{ '/assets/data/blog-graph.json' | relative_url }}">
    <summary>{% if is_zh %}文章导航图{% else %}Article map{% endif %}</summary>
    <p class="graph-intro">{% if is_zh %}箭头从引用文章指向被引用文章。点击节点可以跳转；中英文译文不重复显示。{% else %}Arrows point from a citing article to the article it references. Select a node to read it; translations are shown separately.{% endif %}</p>
    <div class="graph-canvas"></div>
    <p class="graph-status" role="status"></p>
    <div class="graph-links"></div>
  </details>
  {% endif %}
</article>
<script src="{{ '/assets/js/blog-reading.js' | relative_url }}" defer></script>
