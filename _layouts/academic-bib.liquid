---
---
{% assign paper_url = entry.html %}
{% if paper_url == blank and entry.arxiv %}{% assign paper_url = entry.arxiv | prepend: 'https://arxiv.org/abs/' %}{% endif %}
{% if paper_url == blank and entry.doi %}{% assign paper_url = entry.doi | prepend: 'https://doi.org/' %}{% endif %}
<article id="{{ entry.key }}" class="publication{% if entry.preview %} has-preview{% endif %}" aria-labelledby="{{ entry.key }}-title">
  {% if entry.preview %}
    <a class="publication-preview" href="{{ paper_url }}" tabindex="-1" aria-hidden="true">
      <img src="{{ entry.preview | prepend: '/assets/img/publication_preview/' | relative_url }}" alt="" width="360" height="240" loading="lazy">
    </a>
  {% endif %}
  <div class="publication-body">
    <h3 id="{{ entry.key }}-title" class="publication-title">{% if paper_url %}<a href="{{ paper_url }}">{{ entry.title }}</a>{% else %}{{ entry.title }}{% endif %}</h3>
    <p class="publication-authors">{% for author in entry.author_array %}{% unless forloop.first %}, {% endunless %}{% if site.scholar.last_name contains author.last and site.scholar.first_name contains author.first %}<strong>{{ author.first }} {{ author.last }}</strong>{% else %}{{ author.first }} {{ author.last }}{% endif %}{% endfor %}</p>
    <p class="publication-venue">
      {% if entry.abbr == 'arXiv' %}Preprint{% elsif entry.abbr %}{{ entry.abbr }}{% elsif entry.booktitle %}{{ entry.booktitle }}{% else %}{{ entry.journal }}{% endif %} {{ entry.year }}
      {% assign venue_info = site.data.venues[entry.abbr] %}{% if venue_info.ranking %}<span class="publication-ranking">({{ venue_info.ranking }})</span>{% endif %}
    </p>
    <div class="publication-links">
      {% if entry.arxiv %}<a href="https://arxiv.org/abs/{{ entry.arxiv }}">arXiv</a>{% endif %}
      {% if entry.html %}
        {% assign arxiv_url = entry.arxiv | prepend: 'https://arxiv.org/abs/' %}
        {% unless entry.html == arxiv_url %}<a href="{{ entry.html }}">Paper</a>{% endunless %}
      {% endif %}
      {% if entry.pdf %}<a href="{{ entry.pdf }}">PDF</a>{% endif %}
      {% if entry.doi %}<a href="https://doi.org/{{ entry.doi }}">DOI</a>{% endif %}
      {% if entry.bibtex_show %}
        <details class="citation-details">
          <summary>BibTeX</summary>
          <div class="citation-content"><pre><code>{{ entry.bibtex | hideCustomBibtex | escape }}</code></pre></div>
        </details>
      {% endif %}
    </div>
  </div>
</article>
